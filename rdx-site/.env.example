# Copy to .env for local testing (node dev.mjs). On Vercel, add the same keys under Settings → Environment Variables.
# Cloudinary dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Password for /admin (at least 10 characters). Share it only with whoever posts announcements.
ADMIN_PASSWORD=
