{
  "name": "badminton-community",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "local": "bash scripts/setup-local.sh --start",
    "setup:local": "bash scripts/setup-local.sh",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:setup": "node --env-file=.env.local scripts/setup.mjs",
    "db:setup:prod": "node --env-file=.env.production scripts/setup.mjs",
    "db:check": "node --env-file=.env.local scripts/check-db.mjs",
    "db:check:prod": "node --env-file=.env.production scripts/check-db.mjs",
    "db:pull": "bash scripts/neon-to-local.sh",
    "db:dump": "node scripts/migrate.mjs dump --source=local --out=dump.sql",
    "db:restore": "node scripts/migrate.mjs restore --target=neon --in=dump.sql",
    "db:migrate": "node scripts/migrate.mjs dump --source=local | node scripts/migrate.mjs restore --target=neon",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "next": "16.4.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "typescript": "^5"
  }
}
